+
+/// Creates a memfd with Linux `MFD_NOEXEC_SEAL` semantics when requested.
+/// That flag implies sealing is enabled and the initial `F_SEAL_EXEC` is set.
+pub fn create_memfd_file_with_noexec_seal(
+    name: &str,
+    allow_sealing: bool,
+    noexec_seal: bool,
+    cred: Arc<Cred>,
+) -> VfsResult<ShmemObject> {
+    let mut initial_seals = if allow_sealing || noexec_seal {
         ShmemSealSet::empty()
     } else {
         ShmemSealSet::SEAL
     };
+    if noexec_seal {
+        initial_seals.insert(ShmemSealSet::EXEC);
+    }
     create_anonymous_file(
         ShmemObjectKind::Memfd,
         name,
