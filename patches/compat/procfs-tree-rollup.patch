+fn process_descends_from(pid: u32, root_pid: u32, snapshot: &[ProcessSmapsRollupRow]) -> bool {
+    let mut current = pid;
+    for _ in 0..=snapshot.len() {
+        if current == root_pid {
+            return true;
+        }
+        let Some(row) = snapshot.iter().find(|row| row.pid == current) else {
+            return false;
+        };
+        if row.ppid == 0 || row.ppid == current {
+            return false;
+        }
+        current = row.ppid;
+    }
+    false
+}
