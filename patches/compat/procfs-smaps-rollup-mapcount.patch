+    /// Returns the physical frame number for each resident user-page mapping.
+    ///
+    /// Duplicate frame numbers are retained when a frame is aliased in one
+    /// address space. Procfs uses this cold-path snapshot to divide shared
+    /// resident pages across all live process mappings for PSS and USS.
+    /// Linear/device mappings are excluded, matching `memory_usage()`.
+    pub fn resident_page_frames(&self) -> Option<Vec<usize>> {
+        let mut frames = Vec::new();
+        let mut query_failed = false;
+        for vma in self.vmas.iter() {
+            let flags = vma.flags();
+            if !flags.contains(MappingFlags::USER)
+                || matches!(vma.backing().kind(), VmBackingKind::Linear)
+            {
+                continue;
+            }
+            let range = vma.range();
+            let vma_start: usize = range.start.into();
+            let vma_end: usize = range.end.into();
+            let walked = self.pgtbl.visit_present_in_range(
+                range.start,
+                range.end,
+                |leaf_base, leaf_size, leaf_flags| {
+                    if !leaf_flags.contains(MappingFlags::USER) {
+                        return;
+                    }
+                    let leaf_start: usize = leaf_base.into();
+                    let leaf_end = leaf_start.saturating_add(usize::from(leaf_size));
+                    let clip_start = leaf_start.max(vma_start);
+                    let clip_end = leaf_end.min(vma_end);
+                    if clip_end <= clip_start {
+                        return;
+                    }
+                    let Ok((physical_base, _, _)) = self.pgtbl.query(leaf_base) else {
+                        query_failed = true;
+                        return;
+                    };
+                    let physical_base: usize = physical_base.into();
+                    let mut virtual_page = clip_start;
+                    while virtual_page < clip_end {
+                        let physical_page = physical_base + (virtual_page - leaf_start);
+                        frames.push(physical_page / PAGE_SIZE_4K);
+                        virtual_page += PAGE_SIZE_4K;
+                    }
+                },
+            );
+            if walked.is_err() || query_failed {
+                return None;
+            }
+        }
+        if query_failed {
+            None
+        } else {
+            Some(frames)
+        }
+    }
