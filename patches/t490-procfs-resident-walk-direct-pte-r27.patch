     #[def_test]
+    fn visit_present_mappings_returns_physical_leaf_base() {
+        let mut table = TestPageTable::try_new().expect("test page table");
+        let small_page = paddr(0x20_0000);
+        let huge_page = paddr(0x40_0000);
+        let flags = PagingFlags::READ | PagingFlags::WRITE;
+        table
+            .modify()
+            .map(vaddr(0x4000), small_page, PageSize::Size4K, flags)
+            .expect("map 4 KiB page");
+        table
+            .modify()
+            .map(vaddr(0x20_0000), huge_page, PageSize::Size2M, flags)
+            .expect("map 2 MiB page");
+
+        let mut saw_small = false;
+        let mut saw_huge = false;
+        table
+            .visit_present_mappings_in_range(
+                vaddr(0x4000),
+                vaddr(0x40_0000),
+                |virtual_base, physical_base, page_size, entry_flags| {
+                    if virtual_base.as_usize() == 0x4000
+                        && physical_base.as_usize() == small_page.as_usize()
+                        && page_size == PageSize::Size4K
+                        && entry_flags == flags
+                    {
+                        saw_small = true;
+                    }
+                    if virtual_base.as_usize() == 0x20_0000
+                        && physical_base.as_usize() == huge_page.as_usize()
+                        && page_size == PageSize::Size2M
+                        && entry_flags == flags
+                    {
+                        saw_huge = true;
+                    }
+                },
+            )
+            .expect("visit present mappings");
+
+        assert!(saw_small);
+        assert!(saw_huge);
+    }
