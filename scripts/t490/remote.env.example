# T490 connection profile for active (non-historical) operations.
# Copy to remote.env for local use; remote.env is ignored by git.
T490_USER="mo"
T490_IP="10.249.11.192"
T490_TARGET="${T490_USER}@${T490_IP}"
T490_SSH_KEY="${HOME}/.ssh/id_ed25519_t490"
T490_SSH_OPTIONS="-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new"

# Remote workspace locations used by the reproducibility checks.
T490_KERNEL_DIR="/home/${T490_USER}/x-kernel"
T490_WORK_DIR="/home/${T490_USER}/xk6"
T490_EVIDENCE_DIR="${T490_WORK_DIR}/evidence"
