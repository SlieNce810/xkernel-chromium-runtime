# Set T490_TARGET in the invoking shell, for example:
#   T490_TARGET=mo@10.249.11.192 bash scripts/final-acceptance.sh all
# This example deliberately contains no machine address, key, or credential.
T490_TARGET="${T490_TARGET:-}"
T490_SSH_OPTIONS="${T490_SSH_OPTIONS:-}"
T490_SSH_KEY="${T490_SSH_KEY:-}"
SSH_BIN="${SSH_BIN:-ssh}"
SCP_BIN="${SCP_BIN:-scp}"
T490_KERNEL_DIR="${T490_KERNEL_DIR:-/home/mo/x-kernel}"
T490_WORK_DIR="${T490_WORK_DIR:-/home/mo/xk6}"
