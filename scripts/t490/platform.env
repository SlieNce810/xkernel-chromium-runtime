#!/bin/sh
# ============================================================================
# scripts/t490/platform.env
#   赛题六 · 第七节(一)「统一评测平台」的 **单一真源(single source of truth)**
#
# 为什么要有这个文件
# ------------------
# 此前 QEMU 参数散落在 4 个地方（run_session_t490.sh / t490_round.sh /
# t490_build_pkgs.sh / README + 手册），改一处忘一处就会与赛题要求漂移。
# 现在全部收敛到这里：任何脚本引用 QEMU 平台参数都必须 source 本文件，
# 由 scripts/t490/t490_platform_check.sh 做机器可校验的合规断言。
#
# 条款追溯（《赛题六》PDF 第七节）：
#   七(一)1 架构与配置：AArch64 QEMU 虚拟平台（x-kernel kplat-aarch64 平台及
#            组委会发布的 qemu_defconfig 基线配置），不接受其他架构平台参赛。
#   七(一)2 QEMU 规格：qemu-system-aarch64 版本不低于 8.0。全部评分数据必须出自
#            纯 TCG 软件模拟环境，初赛阶段统一禁用 KVM/HVF 等硬件加速。
#   七(一)3 设备组合：virtio-gpu-pci、virtio-input、virtio-blk、virtio-net，
#            以组委会发布基线为准。功能证据统一采用 QEMU monitor screendump 截图。
#   七(二)1/3 性能基线 = 队伍首个可运行版本（git tag 存档）。
#   七(二)4 每项指标 >=5 次取中位数 + 波动范围；注明宿主 CPU 型号、内存、
#            QEMU 版本与操作系统。
#
# 用法：  . "$(dirname "$0")/platform.env"
# ============================================================================

# ---------------------------------------------------------------- 七(一)1 架构
PLAT_ARCH="aarch64"
PLAT_HAL="kplat-aarch64"
# 组委会基线 defconfig。★ 不要用上游 README 的 platforms/<arch>-qemu-virt/defconfig
# （该路径实测 HTTP 404，是 HAL crate 改名前的旧名，见 report/14 §1.1 / report/15）
PLAT_DEFCONFIG="platforms/kplat-aarch64/qemu_defconfig"
PLAT_KCONFIG_SYMBOLS_YES="ARCH_AARCH64=y MACHINE_AARCH64_QEMU=y KFEAT_DRIVER_VIRTIO_GPU=y KFEAT_DRIVER_VIRTIO_INPUT=y KFEAT_VIRTIO_BUS_PCI=y"
PLAT_KCONFIG_ARCH_LINE='^ARCH="aarch64"$'
PLAT_KCONFIG_FORBIDDEN='^ARCH_\(RISCV64\|X86_64\|LOONGARCH64\)=y'

# ---------------------------------------------------------------- 七(一)2 QEMU
PLAT_QEMU_BIN_NAME="qemu-system-aarch64"
PLAT_QEMU_MIN_MAJOR="8"          # 七(一)2：不低于 8.0
PLAT_ACCEL="n"                   # n => xkmake --no-accel => 命令行**不出现** -accel
PLAT_MACHINE="virt,gic-version=3"
PLAT_CPU_TCG="cortex-a76"        # qemu.rs:149 里 host 只在 accel.is_some() 时出现
                                 # => 出现 cortex-a76 本身就是纯 TCG 的判据

# ---------------------------------------------------------------- 七(一)3 设备
PLAT_GRAPHIC="y"                 # y => 追加 virtio-gpu-pci -vga none -serial mon:stdio
PLAT_MEM="4g"                    # MEM 默认为空 => xkmake 落 1g，跑 Chromium 会 OOM
PLAT_SMP="4"                     # 与 defconfig 的 NR_CPUS=4 匹配
PLAT_VSOCK="n"                   # 七(一)3 只要求 4 类设备；关掉可省的 vhost-vsock-pci
PLAT_INPUT_DEVICES="virtio-keyboard-pci virtio-mouse-pci"
# 七(一)3 四类设备在 QEMU 命令行里的字面形态（用于机器断言）
PLAT_REQUIRED_DEVICES="virtio-gpu-pci virtio-blk-pci virtio-net-pci virtio-keyboard-pci virtio-mouse-pci"
# 纯 TCG 下**禁止**出现的加速后端
PLAT_FORBIDDEN_ACCEL="kvm hvf"

# ---------------------------------------------------------------- 派生：make 变量串
# 传给 `make run` / `make justrun` 的变量（顺序无要求，值内不得含空格）
PLAT_MAKE_ARGS="GRAPHIC=$PLAT_GRAPHIC ACCEL=$PLAT_ACCEL MEM=$PLAT_MEM SMP=$PLAT_SMP VSOCK=$PLAT_VSOCK"
PLAT_QEMU_ARGS="$(for d in $PLAT_INPUT_DEVICES; do printf -- '-device %s ' "$d"; done | sed 's/ *$//')"

# ---------------------------------------------------------------- 七(二) 测量规范
PLAT_REPEAT_MIN="5"              # 每项指标重复不少于 5 次
PLAT_STAT="median"               # 取中位数 + 给出波动范围

# ---------------------------------------------------------------- 证据格式约定
PLAT_EVIDENCE_FILES="env.txt console.log cmd.txt timestamps.csv manifest.txt platform-compliance.txt"
PLAT_SCREENSHOT_PREFIX="screenshots/"

# ---------------------------------------------------------------- 第八节 参考资料
# 《赛题六》PDF 第八节给出的 5 条权威参考资料（方案选型与实现应能追溯到这里）
PLAT_REF_XKERNEL="https://gitee.com/openkylin/x-kernel"
PLAT_REF_WAYLAND="https://wayland.freedesktop.org/"
PLAT_REF_XORG_WIKI="https://www.x.org/wiki/"
PLAT_REF_XORG_DOC="https://xorg.freedesktop.org/archive/current/doc/"
PLAT_REF_OZONE="https://chromium.googlesource.com/chromium/src/+/main/docs/ozone_overview.md"
