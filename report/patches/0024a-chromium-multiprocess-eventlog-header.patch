+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license.
+
+#ifndef BASE_TRACE_EVENT_CHROMIUM_MULTIPROCESS_EVENTLOG_H_
+#define BASE_TRACE_EVENT_CHROMIUM_MULTIPROCESS_EVENTLOG_H_
+
+#include <stdint.h>
+
+#include "base/logging.h"
+#include "base/process/process_handle.h"
+#include "base/time/time.h"
+
+namespace base::multiprocess_eventlog {
+
+// Normal builds keep this hook as a no-op. Define
+// CHROMIUM_ENABLE_MULTIPROCESS_EVENTLOG for an instrumented diagnostic build.
+inline void Emit(const char* process_role,
+                 const char* event,
+                 const char* status = "ok",
+                 int64_t navigation_id = 0,
+                 int64_t frame_tree_node_id = 0,
+                 const char* document_id = "",
+                 const char* object_id = "",
+                 const char* error = "") {
+#if defined(CHROMIUM_ENABLE_MULTIPROCESS_EVENTLOG)
+  const int64_t pid = static_cast<int64_t>(base::GetCurrentProcId());
+  const int64_t ppid = static_cast<int64_t>(base::GetParentProcessId(
+      base::GetCurrentProcessHandle()));
+  LOG(INFO) << "MP_EVENT {\"timestamp_monotonic\":"
+            << base::TimeTicks::Now().ToInternalValue()
+            << ",\"process_role\":\"" << process_role
+            << "\",\"pid\":" << pid
+            << ",\"ppid\":" << ppid
+            << ",\"navigation_id\":" << navigation_id
+            << ",\"frame_tree_node_id\":" << frame_tree_node_id
+            << ",\"document_id\":\"" << document_id
+            << "\",\"mojo_endpoint_or_pipe_id\":\"" << object_id
+            << "\",\"shared_object_id_or_file_object_id\":\"" << object_id
+            << "\",\"event\":\"" << event
+            << "\",\"status\":\"" << status
+            << "\",\"error\":\"" << error << "\"}";
+#else
+  (void)process_role;
+  (void)event;
+  (void)status;
+  (void)navigation_id;
+  (void)frame_tree_node_id;
+  (void)document_id;
+  (void)object_id;
+  (void)error;
+#endif
+}
+
+}  // namespace base::multiprocess_eventlog
+
+#endif  // BASE_TRACE_EVENT_CHROMIUM_MULTIPROCESS_EVENTLOG_H_
