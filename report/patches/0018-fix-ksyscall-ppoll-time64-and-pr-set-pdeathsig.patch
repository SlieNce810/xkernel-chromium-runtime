diff --git a/process/kresources/src/lib.rs b/process/kresources/src/lib.rs
index 8c73c29..0398274 100644
--- a/process/kresources/src/lib.rs
+++ b/process/kresources/src/lib.rs
@@ -201,6 +201,20 @@ impl ProcessResources {
         self.add_file(file, cloexec)
     }
 
+    /// Duplicates a descriptor into the first free slot at or above min_fd.
+    pub fn duplicate_file_min(
+        &self,
+        fd: c_int,
+        min_fd: c_int,
+        cloexec: bool,
+    ) -> kerrno::KResult<c_int> {
+        self.with_fd_table(|fd_table| {
+            fd_table
+                .write()
+                .duplicate_from_min(self.max_nofile(), fd, min_fd, cloexec)
+        })
+    }
+
     /// Duplicates a descriptor into a fixed slot.
     ///
     /// The table capacity is checked, but this method does not apply `RLIMIT_NOFILE`.
