+fn tree_identity(root_pid: u32) -> Option<(u64, u64)> {
+    let mut rows: Vec<(u32, u32, u64)> = Vec::new();
+    let mut root_start = None;
+    for process in scheduler::processes() {
+        let pid = process.pid();
+        let Ok(task) = procfs::process_task(pid) else {
+            continue;
+        };
+        let start = task.start_time_ns();
+        let ppid = process.parent().map_or(0, |parent| parent.pid());
+        if pid == root_pid {
+            root_start = Some(start);
+        }
+        rows.push((pid, ppid, start));
+    }
+    let root_start = root_start?;
+    let is_descendant = |pid: u32, rows: &[(u32, u32, u64)]| {
+        let mut current = pid;
+        for _ in 0..=rows.len() {
+            if current == root_pid {
+                return true;
+            }
+            let Some((_, ppid, _)) = rows.iter().find(|(candidate, _, _)| *candidate == current) else {
+                return false;
+            };
+            if *ppid == 0 || *ppid == current {
+                return false;
+            }
+            current = *ppid;
+        }
+        false
+    };
+    let all_rows = rows.clone();
+    rows.retain(|(pid, _, _)| is_descendant(*pid, &all_rows));
+    rows.sort_by_key(|(pid, _, _)| *pid);
+    let mut hash = 1469598103934665603u64;
+    for (pid, ppid, start) in rows {
+        for value in [pid as u64, ppid as u64, start] {
+            hash ^= value;
+            hash = hash.wrapping_mul(1099511628211u64);
+        }
+    }
+    Some((hash, root_start))
+}
