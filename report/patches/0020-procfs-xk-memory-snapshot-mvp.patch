+fn format_xk_memory_snapshot(task: &KtaskRef) -> Vec<u8> {
+    let Some(thread) = task.try_as_thread() else {
+        return b"snapshot version=1 complete=0 reason=root_exited\nsnapshot-end rows=0\n".to_vec();
+    };
+    let root_pid = thread.process().pid();
+    let Some((generation_before, root_start)) = tree_identity(root_pid) else {
+        return format!(
+            "snapshot version=1 root_pid={} complete=0 reason=root_exited\nsnapshot-end rows=0\n",
+            root_pid
+        ).into_bytes();
+    };
+    let Some(snapshot) = process_smaps_rollup_snapshot() else {
+        return format!(
+            "snapshot version=1 root_pid={} root_start={} tree_generation={} t_ns={} clock_id=monotonic complete=0 reason=page_walk_error\nsnapshot-end rows=0\n",
+            root_pid, root_start, generation_before, khal::time::monotonic_time_nanos()
+        ).into_bytes();
+    };
+    let Some((generation_after, _)) = tree_identity(root_pid) else {
+        return format!(
+            "snapshot version=1 root_pid={} root_start={} tree_generation={} t_ns={} clock_id=monotonic complete=0 reason=tree_changed\nsnapshot-end rows=0\n",
+            root_pid, root_start, generation_before, khal::time::monotonic_time_nanos()
+        ).into_bytes();
+    };
+    if generation_before != generation_after {
+        return format!(
+            "snapshot version=1 root_pid={} root_start={} tree_generation={} t_ns={} clock_id=monotonic complete=0 reason=tree_changed\nsnapshot-end rows=0\n",
+            root_pid, root_start, generation_after, khal::time::monotonic_time_nanos()
+        ).into_bytes();
+    }
+    if !snapshot.rows.iter().any(|row| row.pid == root_pid) {
+        return format!(
+            "snapshot version=1 root_pid={} root_start={} tree_generation={} t_ns={} clock_id=monotonic complete=0 reason=root_exited\nsnapshot-end rows=0\n",
+            root_pid, root_start, generation_before, khal::time::monotonic_time_nanos()
+        ).into_bytes();
+    }
+    let t_ns = khal::time::monotonic_time_nanos();
+    let mut output = format!(
+        "snapshot version=1 root_pid={} root_start={} tree_generation={} t_ns={} clock_id=monotonic complete=1 pss_uss_supported=1 resident_walk_ns={} mapcount_ns={} rollup_ns={} process_count={} resident_pages={}\n",
+        root_pid, root_start, generation_before, t_ns, snapshot.resident_walk_ns, snapshot.mapcount_ns,
+        snapshot.rollup_ns, snapshot.process_count, snapshot.resident_pages
+    );
+    let mut rows = 0usize;
+    for row in snapshot.rows.iter().filter(|row| process_descends_from(row.pid, root_pid, &snapshot.rows)) {
+        let start = procfs::process_task(row.pid).ok().map(|task| task.start_time_ns()).unwrap_or(0);
+        if start == 0 {
+            return format!(
+                "snapshot version=1 root_pid={} root_start={} tree_generation={} t_ns={} clock_id=monotonic complete=0 reason=pid_reused\nsnapshot-end rows=0\n",
+                root_pid, root_start, generation_before, t_ns
+            ).into_bytes();
+        }
+        let role = if row.pid == root_pid { "browser" } else { "unknown" };
+        output.push_str(&format!(
+            "process pid={} ppid={} start={} role={} rss_pages={} pss_pages={} uss_pages={} shared_pages={}\n",
+            row.pid, row.ppid, start, role, row.usage.rss_kb / 4,
+            row.usage.pss_kb / 4, row.usage.uss_kb / 4, row.usage.shared_kb / 4
+        ));
+        rows += 1;
+    }
+    if rows == 0 {
+        return format!(
+            "snapshot version=1 root_pid={} root_start={} tree_generation={} t_ns={} clock_id=monotonic complete=0 reason=partial_tree\nsnapshot-end rows=0\n",
+            root_pid, root_start, generation_before, t_ns
+        ).into_bytes();
+    }
+    output.push_str(&format!("snapshot-end rows={}\n", rows));
+    output.into_bytes()
+}
