From 0c611be973668031f80ca82a607d2535cadd8666 Mon Sep 17 00:00:00 2001
From: xk6 <xk6@local>
Date: Mon, 21 Sep 2026 22:26:57 +0800
Subject: [PATCH 7/7] feat(knet): accept SCM_CREDENTIALS on AF_UNIX sockets

`CMsg::parse` only understood SCM_RIGHTS and rejected every other control
message with EINVAL, so a well-formed `(SOL_SOCKET, SCM_CREDENTIALS)` cmsg --
which Linux accepts -- made `sendmsg` fail. Chromium"s crashpad handler uses
AF_UNIX SOCK_SEQPACKET and reports `missing credentials` when the send fails,
after which the child process exits silently during initialization.

Follow Linux (net/core/scm.c) on both counts:

- `scm_send` requires the payload to be exactly one `struct ucred`; any other
  length is EINVAL.
- `scm_check_creds` lets a sender claim only its own identity (pid == caller
  tid, uid/gid among the caller"s), and returns EPERM otherwise unless the
  caller holds CAP_SYS_ADMIN.

The receive side needs no changes: the sender"s `CMsg` is already forwarded to
the receiver and re-serialized by `push_socket_cmsg`, the same path SCM_RIGHTS
uses.

Verified with `credprobe` (scripts/t490/credprobe.c) run both natively on the
Linux host and inside the guest -- 7/7 identical outcomes, including EPERM for
a non-privileged pid=0 claim and EINVAL for a short cmsg.
---
 posix/net/src/cmsg.rs | 37 ++++++++++++++++++++++++++++++++++---
 posix/net/src/io.rs   | 20 +++++++++++++++++---
 2 files changed, 51 insertions(+), 6 deletions(-)

diff --git a/posix/net/src/cmsg.rs b/posix/net/src/cmsg.rs
index 4747b64..014919c 100644
--- a/posix/net/src/cmsg.rs
+++ b/posix/net/src/cmsg.rs
@@ -12,11 +12,11 @@ use core::{mem::size_of, net::SocketAddr, ptr};
 
 use bytemuck::{NoUninit, bytes_of};
 use kerrno::{KError, KResult, LinuxError};
-use knet::{SocketErrorInfo, SocketErrorOrigin};
+use knet::{SocketErrorInfo, SocketErrorOrigin, options::UnixCredentials};
 use kvfs::VfsFile;
 use linux_raw_sys::net::{
-    AF_INET, AF_UNSPEC, IP_RECVERR, IPPROTO_IP, SCM_RIGHTS, SOL_SOCKET, cmsghdr, in_addr,
-    sockaddr_in,
+    AF_INET, AF_UNSPEC, IP_RECVERR, IPPROTO_IP, SCM_CREDENTIALS, SCM_RIGHTS, SOL_SOCKET, cmsghdr,
+    in_addr, sockaddr_in, ucred,
 };
 use osvm::{VirtPtr, write_vm_mem};
 use posix_types::{UserConstPtr, UserPtr};
@@ -135,6 +135,8 @@ pub(crate) fn push_ip_recverr_cmsg(
 pub(crate) enum CMsg {
     /// SCM_RIGHTS: file descriptor passing between processes
     Rights { fds: Vec<Arc<VfsFile>> },
+    /// SCM_CREDENTIALS: the sender's credentials, attached to one message
+    Credentials { cred: UnixCredentials },
 }
 impl CMsg {
     /// Parse a control message header and extract its data
@@ -165,6 +167,35 @@ impl CMsg {
                 }
                 Self::Rights { fds }
             }
+            (SOL_SOCKET, SCM_CREDENTIALS) => {
+                // Linux requires the payload to be exactly one `struct ucred`
+                // (`scm_send`): any other length is EINVAL.
+                if data.len() != size_of::<ucred>() {
+                    return Err(KError::InvalidInput);
+                }
+                let claimed = ucred {
+                    pid: u32::from_ne_bytes(data[0..4].try_into().unwrap()),
+                    uid: u32::from_ne_bytes(data[4..8].try_into().unwrap()),
+                    gid: u32::from_ne_bytes(data[8..12].try_into().unwrap()),
+                };
+                // `scm_check_creds`: a sender may only claim its own identity.
+                // Anything else needs CAP_SYS_ADMIN, otherwise EPERM.
+                let cred = kprocess::current_cred();
+                let privileged = cred.is_privileged();
+                let pid_ok = privileged || claimed.pid == kprocess::current_user_thread().pid();
+                let uid_ok = privileged || claimed.uid == cred.euid();
+                let gid_ok = privileged || claimed.gid == cred.egid();
+                if !(pid_ok && uid_ok && gid_ok) {
+                    return Err(KError::from(LinuxError::EPERM));
+                }
+                Self::Credentials {
+                    cred: UnixCredentials {
+                        pid: claimed.pid,
+                        uid: claimed.uid,
+                        gid: claimed.gid,
+                    },
+                }
+            }
             _ => {
                 return Err(KError::InvalidInput);
             }
diff --git a/posix/net/src/io.rs b/posix/net/src/io.rs
index 704e6f6..ff89c96 100644
--- a/posix/net/src/io.rs
+++ b/posix/net/src/io.rs
@@ -18,15 +18,15 @@ use khal::time::monotonic_time;
 use kio::prelude::*;
 use knet::{
     AncillaryData, KernelAncillaryData, RecvFlags, RecvOptions, SendFlags, SendOptions, Socket,
-    SocketAddrEx, SocketErrorInfo, SocketOps, sock_from_file,
+    SocketAddrEx, SocketErrorInfo, SocketOps, options::UnixCredentials, sock_from_file,
 };
 use ktime_types::TimeSpan;
 use kvfs::VfsFile;
 use linux_raw_sys::{
     general::timespec,
     net::{
-        MSG_CTRUNC, MSG_DONTWAIT, MSG_ERRQUEUE, MSG_PEEK, MSG_TRUNC, SCM_RIGHTS, SOL_SOCKET,
-        cmsghdr, mmsghdr, msghdr, sockaddr, socklen_t,
+        MSG_CTRUNC, MSG_DONTWAIT, MSG_ERRQUEUE, MSG_PEEK, MSG_TRUNC, SCM_CREDENTIALS, SCM_RIGHTS,
+        SOL_SOCKET, cmsghdr, mmsghdr, msghdr, sockaddr, socklen_t, ucred,
     },
 };
 use osvm::{VirtPtr, VmBytes, VmBytesMut, write_vm_mem};
@@ -88,6 +88,7 @@ fn parse_send_cmsgs(
 
 enum SocketAncillary {
     Rights { fds: Vec<Arc<VfsFile>> },
+    Credentials { cred: UnixCredentials },
     IpError(SocketErrorInfo),
 }
 
@@ -100,6 +101,7 @@ fn into_socket_ancillary(ancillary: AncillaryData) -> Option<SocketAncillary> {
         let ancillary = ancillary.downcast::<CMsg>().ok()?;
         return Some(match *ancillary {
             CMsg::Rights { fds } => SocketAncillary::Rights { fds },
+            CMsg::Credentials { cred } => SocketAncillary::Credentials { cred },
         });
     }
     if type_id == TypeId::of::<KernelAncillaryData>() {
@@ -138,6 +140,18 @@ fn push_socket_cmsg(
             }
             Ok(written)
         }),
+        SocketAncillary::Credentials { cred } => {
+            builder.push(SOL_SOCKET, SCM_CREDENTIALS, |data| {
+                if data.len() < size_of::<ucred>() {
+                    return Err(KError::from(LinuxError::ENOBUFS));
+                }
+                // 小端/大端一律按本机序；逐字段写字节以避免对齐假设。
+                data[0..4].copy_from_slice(&cred.pid.to_ne_bytes());
+                data[4..8].copy_from_slice(&cred.uid.to_ne_bytes());
+                data[8..12].copy_from_slice(&cred.gid.to_ne_bytes());
+                Ok(size_of::<ucred>())
+            })
+        }
         SocketAncillary::IpError(err) => push_ip_recverr_cmsg(builder, err),
     }
 }
