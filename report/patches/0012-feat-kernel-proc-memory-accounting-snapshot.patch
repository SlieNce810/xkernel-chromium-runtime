+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2025 KylinSoft Co., Ltd. <https://www.kylinos.cn/>
+// See LICENSES for license details.
+
+//! Current per-address-space memory usage snapshots.
+
+use memaddr::PAGE_SIZE_4K;
+
+/// Linux-compatible current memory usage measured in 4 KiB base pages.
+///
+/// The RSS categories describe the page backing installed in this address
+/// space. In particular, a private file mapping that has been copied into an
+/// anonymous frame is accounted as anonymous memory.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub struct MmMemoryUsage {
+    virtual_pages: u64,
+    anon_pages: u64,
+    file_pages: u64,
+    shmem_pages: u64,
+    peak_resident_pages: u64,
+}
+
+impl MmMemoryUsage {
+    pub(crate) const fn new(
+        virtual_pages: u64,
+        anon_pages: u64,
+        file_pages: u64,
+        shmem_pages: u64,
+        peak_resident_pages: u64,
+    ) -> Self {
+        Self {
+            virtual_pages,
+            anon_pages,
+            file_pages,
+            shmem_pages,
+            peak_resident_pages,
+        }
+    }
+
+    /// Returns total virtual address space in base pages.
+    pub const fn virtual_pages(self) -> u64 {
+        self.virtual_pages
+    }
+
+    /// Returns resident anonymous pages.
+    pub const fn anon_pages(self) -> u64 {
+        self.anon_pages
+    }
+
+    /// Returns resident file-backed pages.
+    pub const fn file_pages(self) -> u64 {
+        self.file_pages
+    }
+
+    /// Returns resident shared-memory pages.
+    pub const fn shmem_pages(self) -> u64 {
+        self.shmem_pages
+    }
+
+    /// Returns total resident pages.
+    pub const fn resident_pages(self) -> u64 {
+        self.anon_pages
+            .saturating_add(self.file_pages)
+            .saturating_add(self.shmem_pages)
+    }
+
+    /// Returns resident file and shared-memory pages for `/proc/<pid>/statm`.
+    pub const fn shared_pages(self) -> u64 {
+        self.file_pages.saturating_add(self.shmem_pages)
+    }
+
+    /// Returns the resident high-water mark for this address space.
+    pub const fn peak_resident_pages(self) -> u64 {
+        let current = self.resident_pages();
+        if self.peak_resident_pages > current {
+            self.peak_resident_pages
+        } else {
+            current
+        }
+    }
+
+    /// Returns the resident high-water mark in KiB.
+    pub const fn peak_resident_kib(self) -> u64 {
+        self.peak_resident_pages()
+            .saturating_mul(PAGE_SIZE_4K as u64)
+            / 1024
+    }
+
+    /// Returns total virtual size in bytes.
+    pub const fn virtual_bytes(self) -> u64 {
+        self.virtual_pages.saturating_mul(PAGE_SIZE_4K as u64)
+    }
+
+    /// Returns resident set size in KiB.
+    pub const fn resident_kib(self) -> u64 {
+        self.resident_pages().saturating_mul(PAGE_SIZE_4K as u64) / 1024
+    }
+}
+
+/// Resident page deltas classified by the page's installed backing.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct ResidentPages {
+    pub(crate) anon: u64,
+    pub(crate) file: u64,
+    pub(crate) shmem: u64,
+}
+
+impl ResidentPages {
+    pub(crate) fn add_assign(&mut self, other: Self) {
+        self.anon = self.anon.saturating_add(other.anon);
+        self.file = self.file.saturating_add(other.file);
+        self.shmem = self.shmem.saturating_add(other.shmem);
+    }
+
+    pub(crate) fn reconcile(&mut self, before: Self, after: Self) {
+        Self::apply_delta(&mut self.anon, before.anon, after.anon);
+        Self::apply_delta(&mut self.file, before.file, after.file);
+        Self::apply_delta(&mut self.shmem, before.shmem, after.shmem);
+    }
+
+    fn apply_delta(current: &mut u64, before: u64, after: u64) {
+        if after >= before {
+            *current = current.saturating_add(after - before);
+        } else {
+            debug_assert!(*current >= before - after);
+            *current = current.saturating_sub(before - after);
+        }
+    }
+}
