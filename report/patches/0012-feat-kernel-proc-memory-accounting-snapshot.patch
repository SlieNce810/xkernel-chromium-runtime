+    /// Visits present leaf mappings intersecting a virtual-address interval.
+    ///
+    /// The walk skips absent page-table branches, so its cost follows the
+    /// populated page-table tree rather than the size of a sparse virtual
+    /// interval. A huge leaf intersecting the interval is reported once with
+    /// its full base address and page size; callers that need a clipped count
+    /// must intersect that leaf with their own range.
+    ///
+    /// This read-only interface is intended for infrequent address-space
+    /// accounting and diagnostics. The caller must keep the page table
+    /// externally stable for the duration of the walk.
+    pub fn visit_present_in_range(
+        &self,
+        start: M::VirtAddr,
+        end: M::VirtAddr,
+        mut visit: impl FnMut(M::VirtAddr, PageSize, PagingFlags),
+    ) -> PtResult<()> {
+        let start: usize = start.into();
+        let end: usize = end.into();
+        if start >= end {
+            return Ok(());
+        }
+        if !M::vaddr_is_valid(start) || !M::vaddr_is_valid(end - 1) {
+            return Err(PtError::InvalidAddress);
+        }
+
+        let root_bits = 12usize + 9usize * M::LEVELS;
+        let root_size = 1usize
+            .checked_shl(root_bits as u32)
+            .ok_or(PtError::InvalidAddress)?;
+        let mut range_start = start;
+        while range_start < end {
+            let root_base = range_start & !(root_size - 1);
+            let root_end = root_base.checked_add(root_size).unwrap_or(usize::MAX);
+            let range_end = end.min(root_end);
+            if range_end <= range_start {
+                return Err(PtError::InvalidAddress);
+            }
+            self.visit_present_table(
+                self.root_paddr,
+                M::LEVELS,
+                root_base,
+                range_start,
+                range_end,
+                &mut visit,
+            )?;
+            range_start = range_end;
+        }
+        Ok(())
+    }
+
+    fn visit_present_table(
+        &self,
+        table_paddr: PhysAddr,
+        level: usize,
+        table_base: usize,
+        range_start: usize,
+        range_end: usize,
+        visit: &mut impl FnMut(M::VirtAddr, PageSize, PagingFlags),
+    ) -> PtResult<()> {
+        let entry_bits = 12usize + 9usize * (level - 1);
+        let entry_size = 1usize
+            .checked_shl(entry_bits as u32)
+            .ok_or(PtError::InvalidAddress)?;
+
+        for (index, entry) in self.table_of(table_paddr).iter().enumerate() {
+            if !entry.is_present() {
+                continue;
+            }
+
+            let entry_base = table_base
+                .checked_add(
+                    index
+                        .checked_mul(entry_size)
+                        .ok_or(PtError::InvalidAddress)?,
+                )
+                .ok_or(PtError::InvalidAddress)?;
+            let entry_end = entry_base
+                .checked_add(entry_size)
+                .ok_or(PtError::InvalidAddress)?;
+            if entry_end <= range_start || entry_base >= range_end {
+                continue;
+            }
+
+            if level == 1 || entry.is_huge() {
+                let page_size = match level {
+                    1 => PageSize::Size4K,
+                    2 => PageSize::Size2M,
+                    3 => PageSize::Size1G,
+                    _ => return Err(PtError::MappedToHugePage),
+                };
+                visit(M::VirtAddr::from(entry_base), page_size, entry.flags());
+            } else {
+                self.visit_present_table(
+                    entry.paddr(),
+                    level - 1,
+                    entry_base,
+                    range_start,
+                    range_end,
+                    visit,
+                )?;
+            }
+        }
