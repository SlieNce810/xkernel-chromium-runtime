+extern "C" unsigned int vpx_variance4x4_neon_dotprod(
+    const unsigned char* src, int src_stride, const unsigned char* ref,
+    int ref_stride, unsigned int* sse) {
+  unsigned int sum = 0;
+  unsigned int error = 0;
+  for (int y = 0; y < 4; ++y) {
+    for (int x = 0; x < 4; ++x) {
+      int d = static_cast<int>(src[y * src_stride + x]) -
+              static_cast<int>(ref[y * ref_stride + x]);
+      sum += static_cast<unsigned int>(d);
+      error += static_cast<unsigned int>(d * d);
+    }
+  }
+  if (sse) *sse = error;
+  return error - (sum * sum >> 4);
+}
